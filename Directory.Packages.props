<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ZeroAlloc.* ecosystem (confirmed shipped versions). -->
    <PackageVersion Include="ZeroAlloc.Mapping" Version="1.3.1" />
    <PackageVersion Include="ZeroAlloc.Mediator" Version="4.1.1" />
    <PackageVersion Include="ZeroAlloc.Results" Version="1.1.1" />
    <PackageVersion Include="ZeroAlloc.ValueObjects" Version="1.4.1" />
    <PackageVersion Include="ZeroAlloc.Validation" Version="1.1.0" />
    <PackageVersion Include="ZeroAlloc.Inject" Version="1.4.1" />
    <PackageVersion Include="ZeroAlloc.Authorization" Version="1.2.1" />
    <PackageVersion Include="ZeroAlloc.Telemetry" Version="1.2.1" />
    <PackageVersion Include="ZeroAlloc.Resilience" Version="1.2.1" />
    <PackageVersion Include="ZeroAlloc.Rest" Version="1.1.1" />
    <PackageVersion Include="ZeroAlloc.Rest.SystemTextJson" Version="1.1.1" />
    <PackageVersion Include="ZeroAlloc.Rest.Resilience" Version="1.1.1" />
    <PackageVersion Include="ZeroAlloc.Mediator.Validation" Version="4.1.1" />
    <PackageVersion Include="ZeroAlloc.Mediator.Generator" Version="4.1.1" />
    <PackageVersion Include="ZeroAlloc.Inject.Generator" Version="1.4.1" />
    <PackageVersion Include="ZeroAlloc.Rest.Generator" Version="1.1.0" />
    <!-- Microsoft / ASP.NET Core (latest stable for net9). -->
    <!-- EF Core 10 ships the AOT-friendly compiled-model runtime path. EF 9
         still calls Expression.Compile from RuntimeEntityType which breaks
         AOT at first DbContext use. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.15" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.2.0" />
    <!-- OpenTelemetry. -->
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.12.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.12.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.12.0-beta.1" />
    <!-- Test stack. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Benchmarks / load. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="NBomber" Version="6.4.0" />
    <PackageVersion Include="NBomber.Http" Version="6.2.0" />
    <!-- Analyzers (injected by Directory.Build.props for non-template projects). -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.78" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
  </ItemGroup>
</Project>
