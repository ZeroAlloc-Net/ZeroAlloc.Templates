<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ZeroAlloc.* ecosystem (confirmed shipped versions). -->
    <PackageVersion Include="ZeroAlloc.Mapping" Version="1.3.1" />
    <PackageVersion Include="ZeroAlloc.Mediator" Version="4.1.0" />
    <PackageVersion Include="ZeroAlloc.Results" Version="1.1.0" />
    <PackageVersion Include="ZeroAlloc.ValueObjects" Version="1.4.1" />
    <PackageVersion Include="ZeroAlloc.Validation" Version="1.1.0" />
    <PackageVersion Include="ZeroAlloc.Inject" Version="1.4.0" />
    <PackageVersion Include="ZeroAlloc.Authorization" Version="1.2.0" />
    <PackageVersion Include="ZeroAlloc.Telemetry" Version="1.2.0" />
    <PackageVersion Include="ZeroAlloc.Resilience" Version="1.2.0" />
    <PackageVersion Include="ZeroAlloc.Rest" Version="1.1.0" />
    <!-- Microsoft / ASP.NET Core (latest stable for net9). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <!-- OpenTelemetry. -->
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.10.0" />
    <!-- Test stack. -->
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Benchmarks / load. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageVersion Include="NBomber" Version="5.7.1" />
    <PackageVersion Include="NBomber.Http" Version="5.4.0" />
  </ItemGroup>
</Project>
