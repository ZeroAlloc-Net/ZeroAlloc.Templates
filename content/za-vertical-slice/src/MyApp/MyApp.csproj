<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyApp</RootNamespace>
    <!-- ZAM003: class request types are fine here.
         ZAM008: handlers intentionally take constructor dependencies — they
         are resolved via DI (services.AddMyApp / ZA.Inject's AddMyAppServices),
         not via the static Mediator API. -->
    <NoWarn>$(NoWarn);ZAM003;ZAM008</NoWarn>
    <!-- AOT publish enabled. Handler registration is hand-listed in
         Common/MyAppServiceCollectionExtensions.cs (AddMyApp); endpoints are
         hand-listed via XxxEndpoint.Map(app) calls near the end of Program.cs.
         Each new slice adds one line to each list — see AGENTS.md §3. -->
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Throughput knobs for the server process. ServerGC gives one heap +
         GC thread per core; TieredPGO recompiles hot methods with PGO layout
         on the JIT path (a no-op under full PublishAot, so it helps the
         `dotnet run` benchmark and any non-AOT deployment). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- This project declares [Policy] / [RequirePolicy]. The vertical-slice
         layout has only one src project, so it owns policies (no sibling src
         project to inherit the Generator transitively from). -->
    <ZeroAllocAuthorizationOwnsPolicies>true</ZeroAllocAuthorizationOwnsPolicies>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core auth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <!-- ZeroAlloc.ORM 1.2.0 + AdoNet.Async substrate (provider selected by
         `Database:Provider` config; default Sqlite). -->
    <PackageReference Include="ZeroAlloc.ORM" />
    <PackageReference Include="ZeroAlloc.ORM.Abstractions" />
    <PackageReference Include="ZeroAlloc.ORM.Generator" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="AdoNet.Async" />
    <PackageReference Include="AdoNet.Async.Adapters" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Npgsql" />

    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />

    <!-- ZeroAlloc: Mediator + Validation + Authorization -->
    <PackageReference Include="ZeroAlloc.Mediator" />
    <PackageReference Include="ZeroAlloc.Mediator.Generator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Mediator.Validation" />
    <PackageReference Include="ZeroAlloc.Mediator.Authorization" />
    <PackageReference Include="ZeroAlloc.Authorization" />
    <PackageReference Include="ZeroAlloc.Authorization.Generator" />
    <PackageReference Include="ZeroAlloc.Validation" />
    <PackageReference Include="ZeroAlloc.Validation.Generator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- ZeroAlloc: primitives + Mapping + Inject + Telemetry/Resilience/Rest -->
    <PackageReference Include="ZeroAlloc.Results" />
    <PackageReference Include="ZeroAlloc.ValueObjects" />
    <!-- Source-gen JsonConverters for [ValueObject] structs declared here
         plus AddZeroAllocValueObjectConverters() extension method called
         from Program.cs's ConfigureHttpJsonOptions. -->
    <PackageReference Include="ZeroAlloc.Serialisation" />
    <PackageReference Include="ZeroAlloc.Serialisation.SystemTextJson" />
    <PackageReference Include="ZeroAlloc.Mapping">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Inject" />
    <PackageReference Include="ZeroAlloc.Inject.Generator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Telemetry" />
    <PackageReference Include="ZeroAlloc.Resilience" />
    <PackageReference Include="ZeroAlloc.Rest" />
    <PackageReference Include="ZeroAlloc.Rest.SystemTextJson" />
    <PackageReference Include="ZeroAlloc.Rest.Resilience" />
  </ItemGroup>
  <ItemGroup>
    <!-- Global usings so the AOT-friendly RequestDelegateGenerator can resolve
         ZA.Mediator's IMediator referenced from minimal-API endpoint lambdas
         (the generator emits scaffolding into a separate file whose namespace
         doesn't import the lambda site's usings). -->
    <Using Include="ZeroAlloc.Mediator" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MyApp.UnitTests" />
    <InternalsVisibleTo Include="MyApp.IntegrationTests" />
    <InternalsVisibleTo Include="MyApp.ConventionTests" />
  </ItemGroup>
  <!-- Embedded SQL migrations applied at startup by ZA.ORM's MigrationRunner.
       Folder-scoped per provider: Migrations/Sqlite/*.sql for Sqlite,
       Migrations/Postgres/*.sql for Postgres. Resource names embed the
       folder name, which the runner uses as a namespace prefix to filter
       by active provider. -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/**/*.sql" />
  </ItemGroup>
</Project>
