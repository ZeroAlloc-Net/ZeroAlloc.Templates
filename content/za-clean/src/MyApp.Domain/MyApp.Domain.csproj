<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyApp.Domain</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZeroAlloc.ValueObjects" />
    <PackageReference Include="ZeroAlloc.Results" />
    <!-- Emits transparent JsonConverters for [ValueObject] partial structs
         declared here (CustomerId, OrderId). The SystemTextJson backend
         reference is what the generator checks via ReferencesSystemTextJson(). -->
    <PackageReference Include="ZeroAlloc.Serialisation" />
    <PackageReference Include="ZeroAlloc.Serialisation.SystemTextJson" />
  </ItemGroup>
</Project>
