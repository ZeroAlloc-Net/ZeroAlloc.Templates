<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyApp.Api</RootNamespace>
    <!-- ZAM003: class request types are fine here.
         SYSLIB1220/SYSLIB1030: the STJ source generator can't resolve the
         JsonConverter type that ZA.Serialisation emits for [ValueObject] typed
         IDs (CustomerId, OrderId) declared in MyApp.Domain — the converter
         lives in Domain's generated output and is invisible to the Api
         generator at compile time. Runtime is unaffected: Program.cs's
         `AddZeroAllocValueObjectConverters()` registers the converter into
         `options.Converters`, which STJ consults BEFORE the TypeInfo
         resolver chain. vs doesn't see this because its [ValueObject]s and
         JsonContext live in the same assembly. -->
    <NoWarn>$(NoWarn);ZAM003;SYSLIB1220;SYSLIB1030</NoWarn>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Throughput knobs for the server process. ServerGC gives one heap +
         GC thread per core (vs the workstation default's single heap) — the
         right choice for a concurrent request server. TieredPGO instruments
         the tier-0 JIT and recompiles hot methods with profile-guided layout;
         it only applies on the JIT path (a no-op under full PublishAot), so it
         helps the `dotnet run` benchmark and any non-AOT deployment. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- Collapse IL2xxx/IL3xxx warnings per source assembly into a single
         summary line. Expected warnings come from OpenTelemetry
         (RequiresDynamicCode for OTel SDK reflection), SQLite
         (DependencyContext.LoadDefault under single-file) and Npgsql. -->
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <!-- ZA.Authorization, ZA.Authorization.Generator, and ZA.Mediator.Authorization
         are NOT referenced directly here. They flow transitively through
         MyApp.Application's ProjectReference. The Generator package's
         buildTransitive guard (shipped in 2.0.1) removes its analyzer from this
         project's @(Analyzer) because we do not set ZeroAllocAuthorizationOwnsPolicies. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Mapping">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <ProjectReference Include="../MyApp.Application/MyApp.Application.csproj" />
    <ProjectReference Include="../MyApp.Infrastructure/MyApp.Infrastructure.csproj" />
  </ItemGroup>
</Project>
