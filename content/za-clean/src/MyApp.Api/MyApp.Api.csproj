<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyApp.Api</RootNamespace>
    <!-- ZAM003: class request types are fine here. -->
    <NoWarn>$(NoWarn);ZAM003</NoWarn>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Collapse IL2xxx/IL3xxx warnings per source assembly into a single
         summary line. Expected warnings come from EF Core (model building
         hooks), OpenTelemetry (RequiresDynamicCode for OTel SDK reflection)
         and SQLite (DependencyContext.LoadDefault under single-file). All
         either guarded at runtime (we use the compiled model + embedded
         schema script) or invoked only outside the hot path. -->
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Embed the schema script so the AOT binary can create the database without
         needing the design-time EF Core pipeline (which is not AOT-compatible).
         Regenerate via `dotnet ef migrations script -o src/MyApp.Api/schema.sql`. -->
    <EmbeddedResource Include="schema.sql" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <!-- ZeroAlloc.Authorization and ZeroAlloc.Mediator.Authorization are NOT referenced
         directly here. They flow transitively through MyApp.Application's ProjectReference
         (runtime + compile assets propagate by default). The analyzer asset is filtered
         out below via an MSBuild target. -->
  </ItemGroup>

  <!-- The ZA.Authorization v2 source generator emits a public extension method
       AddZeroAllocAuthorization on every project that resolves its analyzer. That
       is correct in MyApp.Application (which owns the [Policy] / [RequirePolicy]
       declarations) but causes a CS0121 ambiguous-call at Program.cs:53 when the
       generator ALSO runs here in MyApp.Api — both copies of the extension method
       become equally-good candidates.

       NuGet's PrivateAssets/ExcludeAssets on a PackageReference does NOT reliably
       block analyzer flow through a ProjectReference for this SDK/package combo
       (verified across six verification rounds with `dotnet msbuild -v:diag`).
       The /analyzer: flag passed to csc is populated by targets that ignore
       PrivateAssets=analyzers for ProjectReference graph propagation.

       This target removes the ZA.Authorization-sourced analyzer from MyApp.Api's
       analyzer list before CoreCompile. NuGetPackageId metadata is reliably set
       on Analyzer items by the SDK, so the match is precise. MyApp.Application
       still runs the generator (it has its own direct PackageReference), so the
       v2 contract works end-to-end — just without the duplicate emission here.

       Track upstream: ZeroAlloc.Authorization v2.0.1 should arrange its analyzer
       packaging so transitive consumers don't pick it up by default, eliminating
       the need for this workaround. -->
  <Target Name="RemoveTransitiveZeroAllocAuthorizationAnalyzer" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'ZeroAlloc.Authorization'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Mapping">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <ProjectReference Include="../MyApp.Application/MyApp.Application.csproj" />
    <ProjectReference Include="../MyApp.Infrastructure/MyApp.Infrastructure.csproj" />
  </ItemGroup>
</Project>
