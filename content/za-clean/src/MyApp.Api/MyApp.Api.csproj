<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyApp.Api</RootNamespace>
    <!-- ZAM003: class request types are fine here. -->
    <NoWarn>$(NoWarn);ZAM003</NoWarn>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Collapse IL2xxx/IL3xxx warnings per source assembly into a single
         summary line. Expected warnings come from EF Core (model building
         hooks), OpenTelemetry (RequiresDynamicCode for OTel SDK reflection)
         and SQLite (DependencyContext.LoadDefault under single-file). All
         either guarded at runtime (we use the compiled model + embedded
         schema script) or invoked only outside the hot path. -->
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Embed the schema script so the AOT binary can create the database without
         needing the design-time EF Core pipeline (which is not AOT-compatible).
         Regenerate via `dotnet ef migrations script -o src/MyApp.Api/schema.sql`. -->
    <EmbeddedResource Include="schema.sql" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <!-- Neither ZeroAlloc.Authorization nor ZeroAlloc.Mediator.Authorization is referenced
         directly here. They flow transitively through MyApp.Application's ProjectReference
         (runtime + compile assets propagate by default; the analyzer is blocked by
         Application's PrivateAssets=analyzers on its own ZeroAlloc.Authorization
         PackageReference).

         Why no direct refs:
         - Direct PackageReference at this node would pull ZeroAlloc.Authorization into
           Api's NuGet restore graph independently, and the transitive analyzer brought
           in by ZeroAlloc.Mediator.Authorization → ZeroAlloc.Authorization defeats every
           ExcludeAssets/PrivateAssets suppression we tried at this node (verified across
           multiple rounds).
         - By relying purely on Application's ProjectReference flow, Api's only path to
           the ZA.Authorization analyzer is via Application — and Application sets
           PrivateAssets=analyzers on its ZA.Authorization PackageReference to block that.
           Net result: the analyzer runs exactly once, inside MyApp.Application, which is
           the project that owns the [Policy] / [RequirePolicy] declarations.

         If a future change adds a type to MyApp.Api that needs a direct reference to
         ZeroAlloc.Authorization or ZeroAlloc.Mediator.Authorization (e.g. a custom
         ISecurityContext implementation here in Api), prefer adding it to
         MyApp.Application first; only fall back to a direct reference here as a last
         resort, and re-apply ExcludeAssets=analyzers with awareness that the upstream
         ZA.Authorization v2 generator's transitive flow may still break it. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Mapping">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <ProjectReference Include="../MyApp.Application/MyApp.Application.csproj" />
    <ProjectReference Include="../MyApp.Infrastructure/MyApp.Infrastructure.csproj" />
  </ItemGroup>
</Project>
