<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyApp.Api</RootNamespace>
    <!-- ZAM003: class request types are fine here. -->
    <NoWarn>$(NoWarn);ZAM003</NoWarn>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Collapse IL2xxx/IL3xxx warnings per source assembly into a single
         summary line. Expected warnings come from EF Core (model building
         hooks), OpenTelemetry (RequiresDynamicCode for OTel SDK reflection)
         and SQLite (DependencyContext.LoadDefault under single-file). All
         either guarded at runtime (we use the compiled model + embedded
         schema script) or invoked only outside the hot path. -->
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Embed the schema script so the AOT binary can create the database without
         needing the design-time EF Core pipeline (which is not AOT-compatible).
         Regenerate via `dotnet ef migrations script -o src/MyApp.Api/schema.sql`. -->
    <EmbeddedResource Include="schema.sql" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- ExcludeAssets=analyzers: ZeroAlloc.Authorization 2.0.0 ships its source generator
         bundled in the nupkg. Without this, the generator runs in BOTH MyApp.Application
         (where the [Policy] / [RequirePolicy] types live) AND MyApp.Api, emitting
         duplicate GeneratedAuthorizationRegistration.AddZeroAllocAuthorization extension
         methods. The two would be equally-good candidates at the Program.cs call site
         (Application exposes its emission as public AND has InternalsVisibleTo Api),
         causing CS0121 ambiguous-call errors. MyApp.Api consumes Application's emission;
         it does not declare any [Policy] / [RequirePolicy] of its own, so it doesn't
         need the generator to run here. -->
    <PackageReference Include="ZeroAlloc.Authorization">
      <ExcludeAssets>analyzers</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Mediator.Authorization" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Mapping">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <ProjectReference Include="../MyApp.Application/MyApp.Application.csproj" />
    <ProjectReference Include="../MyApp.Infrastructure/MyApp.Infrastructure.csproj" />
  </ItemGroup>
</Project>
