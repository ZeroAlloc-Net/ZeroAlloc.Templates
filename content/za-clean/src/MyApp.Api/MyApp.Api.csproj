<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyApp.Api</RootNamespace>
    <!-- ZAM003: class request types are fine here. -->
    <NoWarn>$(NoWarn);ZAM003</NoWarn>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Collapse IL2xxx/IL3xxx warnings per source assembly into a single
         summary line. Expected warnings come from EF Core (model building
         hooks), OpenTelemetry (RequiresDynamicCode for OTel SDK reflection)
         and SQLite (DependencyContext.LoadDefault under single-file). All
         either guarded at runtime (we use the compiled model + embedded
         schema script) or invoked only outside the hot path. -->
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Embed the schema script so the AOT binary can create the database without
         needing the design-time EF Core pipeline (which is not AOT-compatible).
         Regenerate via `dotnet ef migrations script -o src/MyApp.Api/schema.sql`. -->
    <EmbeddedResource Include="schema.sql" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- The ZA.Authorization v2 source generator ships bundled in the nupkg. It must
         run in MyApp.Application (which declares [Policy] / [RequirePolicy] types) and
         must NOT run here in MyApp.Api (no policies declared) — otherwise the generator
         emits a duplicate GeneratedAuthorizationRegistration.AddZeroAllocAuthorization
         and CS0121 ambiguous-call fires at Program.cs.

         Three suppression points are needed to fully block the analyzer from running
         in Api, because NuGet has three independent paths through which the analyzer
         could arrive:

         1. Direct PackageReference for ZA.Authorization here, with ExcludeAssets=analyzers.
            Without this, the transitive ZA.Authorization brought in by ZA.Mediator.Authorization
            wins and pulls the analyzer in.
         2. Direct PackageReference for ZA.Mediator.Authorization here, with
            ExcludeAssets=analyzers. ZA.Mediator.Authorization v2 has no analyzer of its own,
            but defense in depth — also blocks any analyzer added in a future patch.
         3. MyApp.Application.csproj sets PrivateAssets=analyzers on its own
            ZA.Authorization PackageReference, so the analyzer doesn't flow transitively
            through the ProjectReference path.

         Tracked as upstream fix candidate: ZA.Mediator.Authorization v2.0.1 should set
         PrivateAssets=analyzers on its own ZA.Authorization PackageReference so consumers
         don't need point #1 here. -->
    <PackageReference Include="ZeroAlloc.Authorization">
      <ExcludeAssets>analyzers</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Mediator.Authorization">
      <ExcludeAssets>analyzers</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Mapping">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <ProjectReference Include="../MyApp.Application/MyApp.Application.csproj" />
    <ProjectReference Include="../MyApp.Infrastructure/MyApp.Infrastructure.csproj" />
  </ItemGroup>
</Project>
