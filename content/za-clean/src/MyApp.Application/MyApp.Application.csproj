<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyApp.Application</RootNamespace>
    <!-- ZAM003: class request types are fine for this template; readability over micro-perf.
         ZAM008: handlers intentionally take constructor dependencies — they are resolved via DI
         (services.AddMediator().RegisterHandlersFromAssembly), not via the static Mediator API. -->
    <NoWarn>$(NoWarn);ZAM003;ZAM008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Mediator" />
    <PackageReference Include="ZeroAlloc.Mediator.Generator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Mediator.Validation" />
    <!-- PrivateAssets=analyzers: ZeroAlloc.Authorization 2.0.0 bundles its source
         generator. Without this, the generator flows transitively to MyApp.Api
         (which references this project) and emits a second copy of
         GeneratedAuthorizationRegistration.AddZeroAllocAuthorization, causing
         CS0121 ambiguous-call at Program.cs. The runtime contract still flows;
         only the analyzer asset is private. -->
    <PackageReference Include="ZeroAlloc.Authorization">
      <PrivateAssets>analyzers</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Mediator.Authorization" />
    <PackageReference Include="ZeroAlloc.Mapping">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Validation" />
    <PackageReference Include="ZeroAlloc.Validation.Generator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Results" />
    <PackageReference Include="ZeroAlloc.Inject" />
    <PackageReference Include="ZeroAlloc.Inject.Generator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../MyApp.Domain/MyApp.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MyApp.Api" />
  </ItemGroup>
</Project>
