<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyApp.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZeroAlloc.ORM" />
    <PackageReference Include="ZeroAlloc.ORM.Abstractions" />
    <PackageReference Include="ZeroAlloc.ORM.Generator" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="AdoNet.Async" />
    <PackageReference Include="AdoNet.Async.Adapters" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="ZeroAlloc.Resilience" />
    <PackageReference Include="ZeroAlloc.Rest" />
    <PackageReference Include="ZeroAlloc.Rest.SystemTextJson" />
    <PackageReference Include="ZeroAlloc.Rest.Resilience" />
    <PackageReference Include="ZeroAlloc.Inject" />
    <PackageReference Include="ZeroAlloc.Inject.Generator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../MyApp.Application/MyApp.Application.csproj" />
  </ItemGroup>

  <!-- Embedded SQL migrations applied at startup by ZA.ORM's MigrationRunner.
       Folder-scoped per provider: Migrations/Sqlite/*.sql for Sqlite,
       Migrations/Postgres/*.sql for Postgres. Resource names embed the
       folder name, which the runner uses as a namespace prefix to filter
       by active provider. -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/**/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyApp.Api" />
  </ItemGroup>
</Project>
