<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyApp.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Resilience" />
    <PackageReference Include="ZeroAlloc.Rest" />
    <PackageReference Include="ZeroAlloc.Rest.SystemTextJson" />
    <PackageReference Include="ZeroAlloc.Rest.Resilience" />
    <PackageReference Include="ZeroAlloc.Inject" />
    <PackageReference Include="ZeroAlloc.Inject.Generator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../MyApp.Application/MyApp.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MyApp.Api" />
  </ItemGroup>

  <!-- ZeroAlloc.Authorization v2 source generator flows transitively from
       MyApp.Application via ProjectReference, causing this assembly to emit
       its own copy of GeneratedAuthorizationRegistration.AddZeroAllocAuthorization.
       That triggers a CS0121 ambiguous-call when Api references both Application
       and Infrastructure. Remove the analyzer here so only Application emits it.
       See MyApp.Api.csproj for the equivalent workaround and upstream tracking. -->
  <Target Name="RemoveTransitiveZeroAllocAuthorizationAnalyzer" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer->WithMetadataValue('NuGetPackageId','ZeroAlloc.Authorization'))" />
    </ItemGroup>
  </Target>
</Project>
