<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyApp.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZeroAlloc.ORM" />
    <PackageReference Include="ZeroAlloc.ORM.Abstractions" />
    <PackageReference Include="ZeroAlloc.ORM.Generator" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="AdoNet.Async" />
    <PackageReference Include="AdoNet.Async.Adapters" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="ZeroAlloc.Resilience" />
    <PackageReference Include="ZeroAlloc.Rest" />
    <PackageReference Include="ZeroAlloc.Rest.SystemTextJson" />
    <PackageReference Include="ZeroAlloc.Rest.Resilience" />
    <PackageReference Include="ZeroAlloc.Inject" />
    <PackageReference Include="ZeroAlloc.Inject.Generator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../MyApp.Application/MyApp.Application.csproj" />
  </ItemGroup>

  <!-- Design-time EF migration scripting: pass /p:EfActiveProvider=Sqlite or
       /p:EfActiveProvider=Postgres to exclude the OTHER provider's migration
       classes from the compiled assembly, so `dotnet ef migrations script`
       sees only the active provider's [Migration]-attributed classes.
       Runtime production builds leave this property unset; both providers'
       migrations compile in, which is fine because runtime uses
       ApplyEmbeddedSchemaAsync, not EF's migration runner. -->
  <ItemGroup>
    <Compile Remove="Persistence/Migrations.Postgres/**/*.cs" Condition="'$(EfActiveProvider)' == 'Sqlite'" />
    <Compile Remove="Persistence/Migrations.Sqlite/**/*.cs" Condition="'$(EfActiveProvider)' == 'Postgres'" />
  </ItemGroup>

  <!-- Embedded schema scripts applied at startup by ApplyEmbeddedSchemaAsync.
       Generated via dotnet ef migrations script (idempotent for Postgres).
       Regenerate via tools/regen-schema.{sh,ps1} after entity changes. -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence/schema.sql" />
    <EmbeddedResource Include="Persistence/schema.postgres.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyApp.Api" />
  </ItemGroup>
</Project>
