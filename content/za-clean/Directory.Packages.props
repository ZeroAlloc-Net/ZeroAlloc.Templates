<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ZeroAlloc.* ecosystem (confirmed shipped versions). -->
    <PackageVersion Include="ZeroAlloc.Mapping" Version="1.6.0" />
    <PackageVersion Include="ZeroAlloc.Mediator" Version="4.1.4" />
    <PackageVersion Include="ZeroAlloc.Results" Version="1.2.0" />
    <PackageVersion Include="ZeroAlloc.ValueObjects" Version="1.7.0" />
    <PackageVersion Include="ZeroAlloc.Serialisation" Version="2.3.3" />
    <PackageVersion Include="ZeroAlloc.Serialisation.SystemTextJson" Version="2.3.3" />
    <PackageVersion Include="ZeroAlloc.Validation" Version="1.5.3" />
    <PackageVersion Include="ZeroAlloc.Validation.Generator" Version="1.5.3" />
    <PackageVersion Include="ZeroAlloc.Inject" Version="1.7.1" />
    <PackageVersion Include="ZeroAlloc.Authorization" Version="2.1.0" />
    <PackageVersion Include="ZeroAlloc.Authorization.Generator" Version="2.1.0" />
    <PackageVersion Include="ZeroAlloc.Telemetry" Version="1.3.0" />
    <PackageVersion Include="ZeroAlloc.Resilience" Version="1.3.0" />
    <PackageVersion Include="ZeroAlloc.Rest" Version="1.1.3" />
    <PackageVersion Include="ZeroAlloc.Rest.SystemTextJson" Version="1.1.1" />
    <PackageVersion Include="ZeroAlloc.Rest.Resilience" Version="1.1.3" />
    <PackageVersion Include="ZeroAlloc.Mediator.Validation" Version="4.1.3" />
    <PackageVersion Include="ZeroAlloc.Mediator.Authorization" Version="4.1.4" />
    <PackageVersion Include="ZeroAlloc.Mediator.Generator" Version="4.1.4" />
    <PackageVersion Include="ZeroAlloc.Inject.Generator" Version="1.7.1" />
    <!-- ZeroAlloc.ORM 1.5.0 + AdoNet.Async substrate (replaces EF Core 10).
         1.5.0 adds: optional IAsyncDbTransaction parameter on [Command]
         partial methods so multi-statement aggregate writes participate
         in a single transaction across providers (#111). Used by
         OrderRepository.AddAsync. -->
    <PackageVersion Include="ZeroAlloc.ORM" Version="1.5.0" />
    <PackageVersion Include="ZeroAlloc.ORM.Abstractions" Version="1.5.0" />
    <PackageVersion Include="ZeroAlloc.ORM.Generator" Version="1.5.0" />
    <PackageVersion Include="AdoNet.Async" Version="1.3.0" />
    <PackageVersion Include="AdoNet.Async.Adapters" Version="1.3.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Microsoft / ASP.NET Core (latest stable for net10). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0" />
    <!-- OpenTelemetry. -->
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <!-- Test stack. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Benchmarks / load. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="NBomber" Version="6.4.1" />
    <PackageVersion Include="NBomber.Http" Version="6.2.0" />
    <!-- Analyzers (injected by Directory.Build.props for non-template projects). -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.102" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
  </ItemGroup>
</Project>
