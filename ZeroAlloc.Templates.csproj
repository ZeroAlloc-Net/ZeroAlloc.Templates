<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>ZeroAlloc.Templates</PackageId>
    <Title>ZeroAlloc.Templates</Title>
    <Description>Clean Architecture Web API template for the ZeroAlloc.* ecosystem.</Description>
    <PackageTags>dotnet-new;templates;clean-architecture;zeroalloc</PackageTags>
    <PackageProjectUrl>https://github.com/ZeroAlloc-Net/ZeroAlloc.Templates</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ZeroAlloc-Net/ZeroAlloc.Templates</RepositoryUrl>
    <Authors>Marcel Roozekrans</Authors>
    <Version>0.1.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**;content/**/*.user" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="assets/icon.png" Pack="true" PackagePath="\" />
    <Compile Remove="**\*.cs" />
  </ItemGroup>
</Project>
